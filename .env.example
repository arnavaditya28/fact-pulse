PORT=3002

# Gemini (free key: https://aistudio.google.com). Judges each search result.
# Models are tried in order; newer ones often return 503 on the free tier.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash

# Web search. Set ONE of these. Serper (serper.dev): 2,500 free queries, no card.
SERPER_API_KEY=
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# Or use Gemini's own Google Search grounding (needs a billed Gemini key):
# SEARCH_PROVIDER=gemini-grounding

# Public Veridex API, for "the community rated a similar claim ..."
VERIDEX_API=https://veridex-n4t2.onrender.com
VERIDEX_SITE=https://getveridex.vercel.app

# Voice: answer with a holding line if a check takes longer than this
VOICE_BUDGET_MS=8000
RESEARCH_TIMEOUT_MS=25000
RATE_LIMIT_PER_MIN=30
