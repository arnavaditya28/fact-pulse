{
  "name": "fact-pulse",
  "version": "1.0.0",
  "description": "Fact Pulse: a voice fact-checker for Alexa+. MCP server (spec 2025-11-25, Streamable HTTP) built on the Veridex reliability engine.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:claims": "node scripts/run-test-claims.js",
    "test:mcp": "node scripts/mcp-smoke.js",
    "test:unit": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vercel/functions": "3.1.4",
    "dotenv": "17.2.3",
    "express": "4.21.2",
    "zod": "3.25.76"
  }
}
